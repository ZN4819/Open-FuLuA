{
  "schema_version": "1.0",
  "templates": [
    {"template_id":"narrative.system.overview","section_id":"system-overview","conclusion":"generic","text":"{system_name}用于{business_scope}，主要服务对象为{service_users}。本段内容应根据系统设计材料和现场核验结果确认。","variables":["system_name","business_scope","service_users"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.assessment.scope","section_id":"assessment-scope","conclusion":"generic","text":"本次测评范围包括{object_summary}。测评边界和对象数量应与资产清单、网络拓扑及附录A保持一致。","variables":["object_summary"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.finding.partially_conformant","section_id":"assessment-results","conclusion":"partially_conformant","text":"经核验，{assessment_object}在{metric_name}方面已采取{implemented_control}，但仍存在{gap_description}，因此判定为部分符合。","variables":["assessment_object","metric_name","implemented_control","gap_description"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.finding.nonconformant","section_id":"assessment-results","conclusion":"nonconformant","text":"经核验，{assessment_object}未能提供{required_evidence}，且现场检查发现{observed_gap}，因此判定为不符合。","variables":["assessment_object","required_evidence","observed_gap"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.risk.recommendation","section_id":"risk-analysis","conclusion":"generic","text":"建议针对{risk_subject}采取{recommended_measure}，并通过{verification_method}验证整改效果。具体措施应由报告负责人结合实际环境确认。","variables":["risk_subject","recommended_measure","verification_method"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.physical.problem","section_id":"security-issues.physical","conclusion":"nonconformant","text":"{assessment_object}未使用密码技术实现重要区域进入人员身份真实性保护，或未使用密码技术保护电子门禁、视频监控记录的存储完整性。","variables":["assessment_object"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.physical.recommendation","section_id":"security-issues.physical","conclusion":"generic","text":"建议针对{assessment_object}采用经商用密码认证机构认证合格的电子门禁系统和密码产品，实现身份鉴别，并对电子门禁、视频监控记录进行完整性保护。","variables":["assessment_object"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.network.problem","section_id":"security-issues.network","conclusion":"nonconformant","text":"{communication_channel}未使用密码技术实现通信实体身份鉴别、通信数据传输机密性或完整性保护，或未保护网络边界访问控制信息的存储完整性。","variables":["communication_channel"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.network.recommendation","section_id":"security-issues.network","conclusion":"generic","text":"建议针对{communication_channel}部署经商用密码认证机构认证合格的安全传输或密码产品，并根据实际通信架构配置合规密码算法和数字证书。","variables":["communication_channel"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.device.problem","section_id":"security-issues.device","conclusion":"nonconformant","text":"{device_name}未使用密码技术实现管理员身份鉴别或安全远程管理，或未保护访问控制信息、日志记录及重要可执行程序的完整性和来源真实性。","variables":["device_name"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.device.recommendation","section_id":"security-issues.device","conclusion":"generic","text":"建议针对{device_name}采用运维堡垒机、安全传输产品和合规密码产品，实现管理员身份鉴别、安全远程管理及重要信息完整性保护。","variables":["device_name"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.application.problem","section_id":"security-issues.application","conclusion":"nonconformant","text":"{application_name}未使用密码技术实现用户身份鉴别，或未保护访问控制信息和重要数据的传输、存储机密性与完整性，以及关键业务行为的不可否认性。","variables":["application_name"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.application.recommendation","section_id":"security-issues.application","conclusion":"generic","text":"建议针对{application_name}采用经商用密码认证机构认证合格的智能密码钥匙、签名验签或服务器密码产品，并按数据类别实现身份鉴别、机密性、完整性和不可否认性保护。","variables":["application_name"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.policy.problem","section_id":"security-issues.policy","conclusion":"nonconformant","text":"{assessed_organization}未建立完整的密码应用安全管理制度、密钥管理规则或操作规程，或缺少制度论证、审定、修订、版本控制及执行记录。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.policy.recommendation","section_id":"security-issues.policy","conclusion":"generic","text":"建议{assessed_organization}依据密码相关标准完善密码应用安全管理制度、密钥管理规则和操作规程，并建立定期评审、版本控制及执行记录留存机制。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.personnel.problem","section_id":"security-issues.personnel","conclusion":"nonconformant","text":"{assessed_organization}未建立密码应用岗位责任或关键岗位人员调离制度，或未留存密码应用培训和考核记录。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.personnel.recommendation","section_id":"security-issues.personnel","conclusion":"generic","text":"建议{assessed_organization}明确密码应用关键岗位职责、制约关系和调离要求，并完整留存培训、考核及保密义务落实记录。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.construction.problem","section_id":"security-issues.construction","conclusion":"nonconformant","text":"{assessed_organization}未制定密码应用方案或实施方案，或未按要求开展攻防对抗演习并留存演习和整改报告。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.construction.recommendation","section_id":"security-issues.construction","conclusion":"generic","text":"建议{assessed_organization}结合系统实际制定并评估密码应用方案和实施方案，按方案实施建设，并定期开展攻防对抗演习及整改验证。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.emergency.problem","section_id":"security-issues.emergency","conclusion":"nonconformant","text":"{assessed_organization}未建立密码应用安全事件处置及向主管部门报告处置情况的相关要求。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"},
    {"template_id":"narrative.security_issue.emergency.recommendation","section_id":"security-issues.emergency","conclusion":"generic","text":"建议{assessed_organization}完善密码应用安全事件应急处置和报告机制，并留存事件处置过程及结果报告。","variables":["assessed_organization"],"user_confirmation_required":true,"template_edition":"2023","template_revision":"2025-12-08"}
